#: C/index.docbook:548
#, no-wrap
msgid ""
"<userinput><command>esdplay "
"/usr/share/sounds/gnibbles/gobble.wav</command></userinput>"
msgstr ""
"<userinput><command>esdplay /usr/share/sounds/gnibbles/gobble.wav</command></"
